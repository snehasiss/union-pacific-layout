{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["profile", "server", "serial", "safety"],
  "additionalProperties": false,
  "properties": {
    "profile": { "type": "string", "enum": ["mac", "cubietruck", "axon"] },
    "server": {
      "type": "object",
      "required": ["host", "port", "secretKey", "allowedOrigins"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "secretKey": { "type": "string", "minLength": 1 },
        "allowedOrigins": { "type": ["string", "array"] }
      }
    },
    "serial": {
      "type": "object",
      "required": ["port", "baudRate", "readTimeoutSeconds", "writeTimeoutSeconds", "connectOnStartup", "reconnect", "reconnectMaxSeconds"],
      "additionalProperties": false,
      "properties": {
        "port": { "type": "string", "minLength": 1 },
        "baudRate": { "type": "integer", "minimum": 1200 },
        "readTimeoutSeconds": { "type": "number", "minimum": 0 },
        "writeTimeoutSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "connectOnStartup": { "type": "boolean" },
        "reconnect": { "type": "boolean" },
        "reconnectMaxSeconds": { "type": "number", "minimum": 1 }
      }
    },
    "safety": {
      "type": "object",
      "required": ["restorePowerAfterReconnect", "restoreThrottlesAfterReconnect", "allowRawCommands"],
      "additionalProperties": false,
      "properties": {
        "restorePowerAfterReconnect": { "const": false },
        "restoreThrottlesAfterReconnect": { "const": false },
        "allowRawCommands": { "type": "boolean" }
      }
    }
  }
}

