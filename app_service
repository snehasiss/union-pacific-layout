#!/usr/bin/env bash
# Control the local Railroad Flask development service.

set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TMP_DIR="$ROOT_DIR/tmp"
PID_FILE="$TMP_DIR/app_service.pid"
LOG_FILE="$TMP_DIR/app_service.log"
PYTHON_BIN="${PYTHON_BIN:-python3}"
HOST="${APP_SERVICE_HOST:-127.0.0.1}"
PORT="${APP_SERVICE_PORT:-5000}"
CONFIG_FILE="$ROOT_DIR/config/railroad-conf.json"

usage() {
    echo "Usage: $0 {start|stop|restart|status}"
}

pid_from_file() {
    [[ -f "$PID_FILE" ]] || return 1
    tr -d '[:space:]' < "$PID_FILE"
}

is_our_service() {
    local pid command
    pid="$(pid_from_file)" || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    command="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    # Some restricted environments disallow process inspection. In that case,
    # a live PID written by this script remains the best available signal.
    [[ -z "$command" || ( "$command" == *"railroad.service"* && "$command" == *"$CONFIG_FILE"* ) ]]
}

clear_stale_pid() {
    if [[ -f "$PID_FILE" ]] && ! is_our_service; then
        local pid
        pid="$(pid_from_file || true)"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            echo "PID $pid is not an app_service Flask process; refusing to stop it." >&2
            exit 1
        fi
        rm -f "$PID_FILE"
    fi
}

start() {
    mkdir -p "$TMP_DIR"
    clear_stale_pid
    if is_our_service; then
        echo "Flask service is already running (PID $(pid_from_file)) at http://$HOST:$PORT/."
        return
    fi

    (
        cd "$ROOT_DIR"
        export PYTHONPATH="$ROOT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
        exec "$PYTHON_BIN" -m railroad.service --config "$CONFIG_FILE" --host "$HOST" --port "$PORT"
    ) >"$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"

    sleep 0.2
    if ! is_our_service; then
        echo "Flask service did not start; see $LOG_FILE" >&2
        rm -f "$PID_FILE"
        exit 1
    fi
    echo "Flask service started (PID $(pid_from_file)) at http://$HOST:$PORT/."
}

stop() {
    clear_stale_pid
    if ! is_our_service; then
        echo "Flask service is not running."
        return
    fi

    local pid
    pid="$(pid_from_file)"
    kill "$pid"
    for _ in {1..20}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "Flask service did not stop cleanly (PID $pid)." >&2
        exit 1
    fi
    rm -f "$PID_FILE"
    echo "Flask service stopped."
}

status() {
    clear_stale_pid
    if is_our_service; then
        echo "Flask service is running (PID $(pid_from_file)) at http://$HOST:$PORT/."
    else
        echo "Flask service is not running."
    fi
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) status ;;
    *) usage; exit 2 ;;
esac
