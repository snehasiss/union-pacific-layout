#!/usr/bin/env bash
# Control the local Railroad Flask development service.

set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TMP_DIR="$ROOT_DIR/tmp"
PID_FILE="$TMP_DIR/app_service.pid"
LOG_FILE="$TMP_DIR/app_service.log"
DEFAULT_PYTHON="$(command -v python3)"
PYTHON_BIN="${PYTHON_BIN:-$DEFAULT_PYTHON}"
HOST="${APP_SERVICE_HOST:-0.0.0.0}"
PORT="${APP_SERVICE_PORT:-5201}"
CONFIG_FILE="$ROOT_DIR/config/railroad-conf.json"

usage() {
    echo "Usage: $0 {start|stop|restart|status}"
}

pid_from_file() {
    [[ -f "$PID_FILE" ]] || return 1
    tr -d '[:space:]' < "$PID_FILE"
}

is_our_service() {
    local pid command
    pid="$(pid_from_file)" || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    command="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    # Some restricted environments disallow process inspection. In that case,
    # a live PID written by this script remains the best available signal.
    [[ -z "$command" || ( "$command" == *"railroad.service"* && "$command" == *"$CONFIG_FILE"* ) ]]
}

clear_stale_pid() {
    if [[ -f "$PID_FILE" ]] && ! is_our_service; then
        local pid
        pid="$(pid_from_file || true)"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            echo "PID $pid is not an app_service Flask process; refusing to stop it." >&2
            exit 1
        fi
        rm -f "$PID_FILE"
    fi
}

validate_runtime() {
    if [[ ! -x "$PYTHON_BIN" ]]; then
        echo "Python runtime not found or not executable: $PYTHON_BIN" >&2
        echo "Restore the system Python dependencies, or set PYTHON_BIN explicitly." >&2
        exit 1
    fi
    if ! "$PYTHON_BIN" -c 'import flask' >/dev/null 2>&1; then
        echo "Flask is not installed in Python runtime: $PYTHON_BIN" >&2
        echo "Install the project dependencies there, or set PYTHON_BIN to the correct environment." >&2
        exit 1
    fi
}

start() {
    mkdir -p "$TMP_DIR"
    clear_stale_pid
    if is_our_service; then
        echo "Flask service is already running (PID $(pid_from_file)) at http://$HOST:$PORT/."
        return
    fi
    validate_runtime

    (
        cd "$ROOT_DIR"
        export PYTHONPATH="$ROOT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
        exec "$PYTHON_BIN" -m railroad.service --config "$CONFIG_FILE" --host "$HOST" --port "$PORT"
    ) >"$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"

    local ready=false
    for _ in {1..50}; do
        if ! is_our_service; then
            break
        fi
        if curl --silent --fail --max-time 1 "http://127.0.0.1:$PORT/" >/dev/null 2>&1; then
            ready=true
            break
        fi
        sleep 0.1
    done
    if [[ "$ready" != true ]]; then
        local pid
        pid="$(pid_from_file || true)"
        if [[ -n "$pid" ]] && is_our_service; then
            kill "$pid" 2>/dev/null || true
        fi
        rm -f "$PID_FILE"
        echo "Flask service did not become ready; see $LOG_FILE" >&2
        exit 1
    fi
    echo "Flask service started (PID $(pid_from_file)) at http://$HOST:$PORT/."
}

stop() {
    clear_stale_pid
    if ! is_our_service; then
        echo "Flask service is not running."
        return
    fi

    local pid
    pid="$(pid_from_file)"
    kill "$pid"
    for _ in {1..20}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "Flask service did not stop cleanly (PID $pid)." >&2
        exit 1
    fi
    rm -f "$PID_FILE"
    echo "Flask service stopped."
}

status() {
    clear_stale_pid
    if is_our_service; then
        echo "Flask service is running (PID $(pid_from_file)) at http://$HOST:$PORT/."
    else
        echo "Flask service is not running."
    fi
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) status ;;
    *) usage; exit 2 ;;
esac
